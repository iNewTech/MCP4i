/* ILE CL build driver for source already copied into the IBM i IFS.      */
/* SCHEMA creates files once; UPGRADE adds tool columns to old installs.   */
/* APP rebuilds code only. Never use SCHEMA to upgrade an installation.   */
/* Customer MCP wrappers are compiled separately after source review.    */
/* SRCROOT is the absolute IFS path to this mcplib directory, no slash.  */
PGM PARM(&MODE &SRCROOT)
  DCL VAR(&MODE) TYPE(*CHAR) LEN(10)
  DCL VAR(&SRCROOT) TYPE(*CHAR) LEN(256)
  DCL VAR(&STMF) TYPE(*CHAR) LEN(512)
  DCL VAR(&COPYDIR) TYPE(*CHAR) LEN(512)
  DCL VAR(&RPGOPTS) TYPE(*CHAR) LEN(600)

  IF COND(&SRCROOT *EQ ' ') THEN(DO)
    SNDPGMMSG MSG('Specify the absolute mcplib IFS directory.') +
      MSGTYPE(*ESCAPE)
  ENDDO

  CHKOBJ OBJ(MCPLIB) OBJTYPE(*LIB)
  MONMSG MSGID(CPF9801) EXEC(CRTLIB LIB(MCPLIB) +
    TEXT('MCP for i application'))

  IF COND(&MODE *EQ 'SCHEMA') THEN(DO)
    /* One-time install. Never run this branch for a code-only rebuild. */
    CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/sql/SCHEMA.sql')
    RUNSQLSTM SRCSTMF(&STMF) COMMIT(*NONE) NAMING(*SQL)
    RETURN
  ENDDO

  IF COND(&MODE *EQ 'UPGRADE') THEN(DO)
    /* Add columns to MCPTOOLT and existing Tnnnnnnn files in place. */
    CHKOBJ OBJ(MCPLIB/MCPCAT) OBJTYPE(*FILE)
    CHKOBJ OBJ(MCPLIB/MCPTOOLT) OBJTYPE(*FILE)
    CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/sql/UPGRADE_GENERATION.sql')
    RUNSQLSTM SRCSTMF(&STMF) COMMIT(*NONE) NAMING(*SQL)
    RETURN
  ENDDO

  IF COND(&MODE *NE 'APP') THEN(DO)
    SNDPGMMSG MSG('MODE must be APP, SCHEMA or UPGRADE.') +
      MSGTYPE(*ESCAPE)
  ENDDO

  /* Static SQL in the administrative programs needs these data files. */
  CHKOBJ OBJ(MCPLIB/MCPCAT) OBJTYPE(*FILE)
  CHKOBJ OBJ(MCPLIB/MCPCFGT) OBJTYPE(*FILE)
  CHKOBJ OBJ(MCPLIB/MCPTOOLT) OBJTYPE(*FILE)

  /* DDS cannot be compiled directly from SRCSTMF. Keep only DDS source
     in QDDSSRC; the registry tables and their rows are left alone. */
  CHKOBJ OBJ(MCPLIB/QDDSSRC) OBJTYPE(*FILE)
  MONMSG MSGID(CPF9801) EXEC(CRTSRCPF FILE(MCPLIB/QDDSSRC) +
    RCDLEN(112) TEXT('MCP display DDS source'))
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/dds/MCPSRVD.dspf')
  CPYFRMSTMF FROMSTMF(&STMF) +
    TOMBR('/QSYS.LIB/MCPLIB.LIB/QDDSSRC.FILE/MCPSRVD.MBR') +
    MBROPT(*REPLACE) CVTDTA(*AUTO) STMFCCSID(1208) ENDLINFMT(*LF)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/dds/MCPTOOLD.dspf')
  CPYFRMSTMF FROMSTMF(&STMF) +
    TOMBR('/QSYS.LIB/MCPLIB.LIB/QDDSSRC.FILE/MCPTOOLD.MBR') +
    MBROPT(*REPLACE) CVTDTA(*AUTO) STMFCCSID(1208) ENDLINFMT(*LF)
  CRTDSPF FILE(MCPLIB/MCPSRVD) SRCFILE(MCPLIB/QDDSSRC) +
    SRCMBR(MCPSRVD) REPLACE(*YES)
  CRTDSPF FILE(MCPLIB/MCPTOOLD) SRCFILE(MCPLIB/QDDSSRC) +
    SRCMBR(MCPTOOLD) REPLACE(*YES)

  CHGVAR VAR(&COPYDIR) VALUE(&SRCROOT *TCAT '/copy')
  /* SQL INCDIR is for SQL INCLUDE; the RPG compiler needs COMPILEOPT. */
  CHGVAR VAR(&RPGOPTS) VALUE('INCDIR(''' *CAT &COPYDIR *TCAT ''')')
  /* Compile each RPG source to a module before binding any program. */
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/rpg/MCPJSON.sqlrpgle')
  CRTSQLRPGI OBJ(MCPLIB/MCPJSON) SRCSTMF(&STMF) OBJTYPE(*MODULE) +
    COMMIT(*NONE) RDB(*NONE) OUTPUT(*PRINT) RPGPPOPT(*LVL2) +
    INCDIR(&COPYDIR) COMPILEOPT(&RPGOPTS) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/rpg/MCPREG.sqlrpgle')
  CRTSQLRPGI OBJ(MCPLIB/MCPREG) SRCSTMF(&STMF) OBJTYPE(*MODULE) +
    COMMIT(*NONE) RDB(*NONE) OUTPUT(*PRINT) RPGPPOPT(*LVL2) +
    INCDIR(&COPYDIR) COMPILEOPT(&RPGOPTS) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/rpg/MCPHTTP.sqlrpgle')
  CRTSQLRPGI OBJ(MCPLIB/MCPHTTP) SRCSTMF(&STMF) OBJTYPE(*MODULE) +
    COMMIT(*NONE) RDB(*NONE) OUTPUT(*PRINT) RPGPPOPT(*LVL2) +
    INCDIR(&COPYDIR) COMPILEOPT(&RPGOPTS) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/rpg/SYSINFHND.sqlrpgle')
  CRTSQLRPGI OBJ(MCPLIB/SYSINFHND) SRCSTMF(&STMF) OBJTYPE(*MODULE) +
    COMMIT(*NONE) RDB(*NONE) OUTPUT(*PRINT) RPGPPOPT(*LVL2) +
    INCDIR(&COPYDIR) COMPILEOPT(&RPGOPTS) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/rpg/MCPLIBLIST.sqlrpgle')
  CRTSQLRPGI OBJ(MCPLIB/MCPLIBLIST) SRCSTMF(&STMF) OBJTYPE(*MODULE) +
    COMMIT(*NONE) RDB(*NONE) OUTPUT(*PRINT) RPGPPOPT(*LVL2) +
    INCDIR(&COPYDIR) COMPILEOPT(&RPGOPTS) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/rpg/MCPSRVAD.sqlrpgle')
  CRTSQLRPGI OBJ(MCPLIB/MCPSRVAD) SRCSTMF(&STMF) OBJTYPE(*MODULE) +
    COMMIT(*NONE) RDB(*NONE) OUTPUT(*PRINT) RPGPPOPT(*LVL2) +
    INCDIR(&COPYDIR) COMPILEOPT(&RPGOPTS) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/rpg/MCPTOOLADD.sqlrpgle')
  CRTSQLRPGI OBJ(MCPLIB/MCPTOOLADD) SRCSTMF(&STMF) OBJTYPE(*MODULE) +
    COMMIT(*NONE) RDB(*NONE) OUTPUT(*PRINT) RPGPPOPT(*LVL2) +
    INCDIR(&COPYDIR) COMPILEOPT(&RPGOPTS) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/rpg/MCPSRVOP.sqlrpgle')
  CRTSQLRPGI OBJ(MCPLIB/MCPSRVOP) SRCSTMF(&STMF) OBJTYPE(*MODULE) +
    COMMIT(*NONE) RDB(*NONE) OUTPUT(*PRINT) RPGPPOPT(*LVL2) +
    INCDIR(&COPYDIR) COMPILEOPT(&RPGOPTS) REPLACE(*YES)

  CRTPGM PGM(MCPLIB/MCPHTTP) MODULE(MCPLIB/MCPHTTP +
    MCPLIB/MCPREG MCPLIB/MCPJSON) BNDSRVPGM(QHTTPSVR/QZHBCGI) +
    REPLACE(*YES)
  CRTPGM PGM(MCPLIB/SYSINFHND) MODULE(MCPLIB/SYSINFHND) +
    REPLACE(*YES)
  CRTPGM PGM(MCPLIB/MCPLIBLIST) MODULE(MCPLIB/MCPLIBLIST) +
    REPLACE(*YES)
  CRTPGM PGM(MCPLIB/MCPSRVAD) MODULE(MCPLIB/MCPSRVAD) +
    REPLACE(*YES)
  CRTPGM PGM(MCPLIB/MCPTOOLADD) MODULE(MCPLIB/MCPTOOLADD) +
    REPLACE(*YES)
  CRTPGM PGM(MCPLIB/MCPSRVOP) MODULE(MCPLIB/MCPSRVOP) +
    BNDDIR(QSYS/QC2LE) REPLACE(*YES)

  /* Command processing programs must exist before their *CMD objects. */
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/cmd/CRTMCPSRV.cmd')
  CRTCMD CMD(MCPLIB/CRTMCPSRV) PGM(MCPLIB/MCPSRVAD) +
    SRCSTMF(&STMF) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/cmd/CHGMCPSRV.cmd')
  CRTCMD CMD(MCPLIB/CHGMCPSRV) PGM(MCPLIB/MCPSRVAD) +
    SRCSTMF(&STMF) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/cmd/STRMCPSRV.cmd')
  CRTCMD CMD(MCPLIB/STRMCPSRV) PGM(MCPLIB/MCPSRVOP) +
    SRCSTMF(&STMF) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/cmd/ENDMCPSRV.cmd')
  CRTCMD CMD(MCPLIB/ENDMCPSRV) PGM(MCPLIB/MCPSRVOP) +
    SRCSTMF(&STMF) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/cmd/ADDMCPTOOL.cmd')
  CRTCMD CMD(MCPLIB/ADDMCPTOOL) PGM(MCPLIB/MCPTOOLADD) +
    SRCSTMF(&STMF) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/cmd/EDTMCPTOOL.cmd')
  CRTCMD CMD(MCPLIB/EDTMCPTOOL) PGM(MCPLIB/MCPTOOLADD) +
    SRCSTMF(&STMF) REPLACE(*YES)
  CHGVAR VAR(&STMF) VALUE(&SRCROOT *TCAT '/cmd/RMVMCPTOOL.cmd')
  CRTCMD CMD(MCPLIB/RMVMCPTOOL) PGM(MCPLIB/MCPTOOLADD) +
    SRCSTMF(&STMF) REPLACE(*YES)
ENDPGM
