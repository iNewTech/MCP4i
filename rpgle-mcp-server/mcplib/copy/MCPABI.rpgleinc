// All standalone MCP handler *PGM objects use these fixed buffer sizes.
// Keep their four by-reference PI arguments in this exact order:
// argsJson CHAR(8192), resultJson CHAR(8192), resultLen INT(10),
// statusCode INT(10). A nonzero status is returned as an MCP tool error.
dcl-c MCP_ARGS_SIZE 8192;
dcl-c MCP_RESULT_SIZE 8192;
dcl-c MCP_PAYLOAD_LIMIT 4096;
