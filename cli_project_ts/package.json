{
  "name": "mcp4i-cli-project-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "server": "tsx src/mcp_server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "inspect": "npx -y @modelcontextprotocol/inspector@latest ./node_modules/.bin/tsx src/mcp_server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ollama": "^0.6.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.14",
    "typescript": "^5.9.3"
  }
}
